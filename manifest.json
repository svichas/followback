{
  "manifest_version": 3,
  "name": "Followback",
  "version": "1.0.0",
  "description": "See who doesn't follow you back on Instagram — and unfollow them at a safe pace.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "unlimitedStorage"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Followback",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"]
    }
  ]
}
